{
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/auth/{everything}",
      "UpstreamHttpMethod": [ "Post" ],
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [ { "Host": "vetlab15-api.onrender.com", "Port": 443 } ]
    },
    {
      "UpstreamPathTemplate": "/gateway/auth/perfil",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/api/auth/perfil",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [ { "Host": "vetlab15-api.onrender.com", "Port": 443 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "UpstreamPathTemplate": "/gateway/mascotas{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/api/mascotas{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [ { "Host": "vetlab15-api.onrender.com", "Port": 443 } ]
    },
    {
      "UpstreamPathTemplate": "/gateway/mascotas{everything}",
      "UpstreamHttpMethod": [ "Post", "Put", "Delete" ],
      "DownstreamPathTemplate": "/api/mascotas{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [ { "Host": "vetlab15-api.onrender.com", "Port": 443 } ],
      "DownstreamHeaderTransform": { "Location": "https://vetlab15-api.onrender.com/api/, https://vetlab15-gateway.onrender.com/gateway/" },
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "UpstreamPathTemplate": "/gateway/citas{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/api/citas{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [ { "Host": "vetlab15-api.onrender.com", "Port": 443 } ]
    },
    {
      "UpstreamPathTemplate": "/gateway/citas{everything}",
      "UpstreamHttpMethod": [ "Post", "Put", "Delete" ],
      "DownstreamPathTemplate": "/api/citas{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [ { "Host": "vetlab15-api.onrender.com", "Port": 443 } ],
      "DownstreamHeaderTransform": { "Location": "https://vetlab15-api.onrender.com/api/, https://vetlab15-gateway.onrender.com/gateway/" },
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "UpstreamPathTemplate": "/gateway/propietarios{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/api/propietarios{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [ { "Host": "vetlab15-propietarios.onrender.com", "Port": 443 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://vetlab15-gateway.onrender.com"
  }
}
